    "columns": 5,
    "spacingScale": 1,
    "textScale": 1,
    "focusScale": 1.1,
    "weather": {
      "formats": [
        "text",
        "current",
        "details",
        "forecast"
      ],
      "scale": 1,
      "padding": 28,
      "icons": "fill"
    }
  },
