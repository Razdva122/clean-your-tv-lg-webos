{
  "schemaVersion": 1,
  "themeApiVersion": 1,
  "id": "github:razdva122/clean-your-tv-lg-webos:alpine",
  "title": "Alpine",
  "description": "A real 4K Bachalpsee photograph, large clock and one infinitely looping horizontal app ribbon.",
  "author": {
    "name": "Clean Your TV contributors",
    "url": "https://github.com/razdva122"
  },
  "themeVersion": "1.6.0",
  "layout": {
    "preset": "scenic-grid",
    "columns": 8,
    "spacingScale": 1,
    "textScale": 1,
    "focusScale": 1.1,
    "allowColumnOverride": false,
    "weather": {
      "formats": [
        "text",
        "current",
        "details",
        "forecast"
      ],
      "scale": 1,
      "padding": 28,
      "icons": "fill"
    }
  },
  "defaults": {
    "wallpaperAssetId": "landscape",
    "dim": 0.36,
    "accent": "#ece7df"
  },
  "assets": [
    {
      "id": "preview",
      "path": "assets/preview.jpg",
      "mediaType": "image/jpeg",
      "width": 960,
      "height": 540
    },
    {
      "id": "landscape",
      "path": "assets/bachsee.jpg",
      "mediaType": "image/jpeg",
      "width": 3840,
      "height": 2160
    },
    {
      "id": "button-inputs",
      "path": "assets/button-inputs.png",
      "mediaType": "image/png",
      "width": 96,
      "height": 96
    },
    {
      "id": "button-network",
      "path": "assets/button-network.png",
      "mediaType": "image/png",
      "width": 96,
      "height": 96
    },
    {
      "id": "button-settings",
      "path": "assets/button-settings.png",
      "mediaType": "image/png",
      "width": 96,
      "height": 96
    },
    {
      "id": "inputs-preview",
      "path": "assets/inputs-preview.png",
      "mediaType": "image/png",
      "width": 960,
      "height": 540
    },
    {
      "id": "settings-preview",
      "path": "assets/settings-preview.png",
      "mediaType": "image/png",
      "width": 960,
      "height": 540
    },
    {
      "id": "library-preview",
      "path": "assets/library-preview.png",
      "mediaType": "image/png",
      "width": 960,
      "height": 540
    }
  ],
  "previewAssetId": "preview",
  "license": {
    "identifier": "MIT AND CC-BY-SA-3.0-DE",
    "textPath": "LICENSE.txt",
    "creditsPath": "CREDITS.txt"
  },
  "wallpaperVideo": {
    "variants": [
      {
        "quality": "4k",
        "path": "assets/wallpaper-4k.mp4"
      },
      {
        "quality": "1080p",
        "path": "assets/wallpaper-1080p.mp4"
      }
    ]
  }
}
