{
  "schemaVersion": 1,
  "themeApiVersion": 1,
  "id": "github:razdva122/clean-your-tv-lg-webos:alpine",
  "title": "Alpine",
  "description": "A quiet alpine panorama, large clock and one infinitely looping horizontal app ribbon.",
  "author": {
    "name": "Clean Your TV contributors",
    "url": "https://github.com/razdva122"
  },
  "themeVersion": "1.4.4",
  "layout": {
    "preset": "scenic-grid",
    "columns": 8,
    "spacingScale": 1,
    "textScale": 1,
    "focusScale": 1.1,
    "allowColumnOverride": false
  },
  "defaults": {
    "wallpaperAssetId": "landscape",
    "dim": 0.36,
    "accent": "#ece7df"
  },
  "assets": [
    {
      "id": "preview",
      "path": "assets/preview.png",
      "mediaType": "image/png",
      "width": 960,
      "height": 540
    },
    {
      "id": "landscape",
      "path": "assets/fronalpstock.jpg",
      "mediaType": "image/jpeg",
      "width": 3840,
      "height": 2160
    },
    {
      "id": "button-inputs",
      "path": "assets/button-inputs.png",
      "mediaType": "image/png",
      "width": 96,
      "height": 96
    },
    {
      "id": "button-network",
      "path": "assets/button-network.png",
      "mediaType": "image/png",
      "width": 96,
      "height": 96
    },
    {
      "id": "button-settings",
      "path": "assets/button-settings.png",
      "mediaType": "image/png",
      "width": 96,
      "height": 96
    },
    {
      "id": "inputs-preview",
      "path": "assets/inputs-preview.png",
      "mediaType": "image/png",
      "width": 960,
      "height": 540
    },
    {
      "id": "settings-preview",
      "path": "assets/settings-preview.png",
      "mediaType": "image/png",
      "width": 960,
      "height": 540
    },
    {
      "id": "library-preview",
      "path": "assets/library-preview.png",
      "mediaType": "image/png",
      "width": 960,
      "height": 540
    }
  ],
  "previewAssetId": "preview",
