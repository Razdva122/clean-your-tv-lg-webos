{
  "schemaVersion": 1,
  "themeApiVersion": 1,
  "id": "builtin:ribbon",
  "title": "Ribbon",
  "description": "Black Hole by Xecutioner, recorded at native 3840x2160, with a fixed eight-card skewed app ribbon.",
  "author": {
    "name": "CYTV contributors; video by Xecutioner",
    "url": "https://github.com/razdva122"
  },
  "themeVersion": "1.4.0",
  "layout": {
    "preset": "scenic-grid",
    "columns": 8,
    "spacingScale": 1,
    "textScale": 1,
    "focusScale": 1.1,
    "allowColumnOverride": false,
    "ribbon": {
      "left": 256,
      "right": 84,
      "bottom": 0,
      "cardHeight": 180,
      "gap": 0,
      "skewDeg": -13,
      "focusLift": 36,
      "shortcuts": "bottom-left",
      "edgeNavigation": "shortcuts",
      "labels": "focused-above",
      "showClock": false,
      "iconScale": 0.65
    },
    "weather": {
      "formats": [],
      "scale": 1,
      "padding": 0,
      "icons": "fill"
    }
  },
  "defaults": {
    "wallpaperAssetId": "wallpaper",
    "dim": 0.28,
    "accent": "#ffffff"
  },
  "assets": [
    {
      "id": "wallpaper",
      "path": "assets/wallpaper.jpg",
      "mediaType": "image/jpeg",
      "width": 3840,
      "height": 2160
    },
    {
      "id": "preview",
      "path": "assets/preview.jpg",
      "mediaType": "image/jpeg",
      "width": 960,
      "height": 540
    }
  ],
  "previewAssetId": "preview",
  "license": {
    "identifier": "LicenseRef-Xecutioner-NonCommercial",
    "textPath": "LICENSE.txt",
    "creditsPath": "CREDITS.txt"
  },
  "wallpaperVideo": {
    "variants": [
      {
        "quality": "4k",
        "path": "assets/wallpaper-4k.mp4"
      },
      {
        "quality": "1080p",
        "path": "assets/wallpaper-1080p.mp4"
      }
    ]
  }
}
