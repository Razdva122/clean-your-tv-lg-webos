---
import { support } from '../lib/support';
import { articleCopy, articleRoute, getArticles } from '../lib/articles';
import { copy, route, base, repo, type Locale } from '../lib/site';
const { lang } = Astro.props as { lang: Locale };
const t = copy[lang],
  extra = support[lang];
const articles = (await getArticles()).filter(
  (entry) => entry.data.lang === lang
);
---

<section class="hero shell">
  <div class="intro-grid">
    <h1>{t.headline}</h1>
    <p class="lead">{t.summary}</p>
    <div class="actions">
      <a class="button" href={route(lang, 'install')}>
        {t.nav[1]}
      </a>
      <a class="button secondary" href={base + 'demo/'}>
        {t.tryDemo}
      </a>
    </div>
  </div>
  <figure class="tv" data-kind="product">
    <a class="tv-screen" href={base + 'demo/'} aria-label={t.tryDemo}>
      <img
        src={base + 'assets/liquid-glass.jpg'}
        alt={`${t.themeImage}: Liquid Glass`}
        width="960"
        height="540"
        fetchpriority="high"
      />
    </a>
    <figcaption>
      <span>Liquid Glass</span>
      <a href={base + 'demo/'}>
        {t.tryDemo}
        <span aria-hidden="true"> ↗</span>
      </a>
    </figcaption>
  </figure>
</section>

<section class="shell benefits" aria-label={t.readMore}>
  <div class="benefit-grid">
    {t.features.map((text) => (
      <p>{text}</p>
    ))}
  </div>
</section>

<section class="shell theme-section">
  <div class="section-heading">
    <h2>{t.nav[4]}</h2>
    <p>{t.themes}</p>
  </div>
  <div class="theme-grid">
    {['Classic', 'Liquid Glass', 'Ribbon'].map((theme) => (
      <figure data-kind="product">
        <a href={base + 'demo/'} aria-label={`${theme}: ${t.tryDemo}`}>
          <img
            src={
              base + 'assets/' + theme.toLowerCase().replace(/ /g, '-') + '.jpg'
            }
            alt={`${t.themeImage}: ${theme}`}
            width="1920"
            height="1080"
            loading="lazy"
          />
        </a>
        <figcaption>{theme}</figcaption>
      </figure>
    ))}
  </div>
  <a class="text-link" href={route(lang, 'themes')}>
    {t.nav[4]}
    <span aria-hidden="true"> ↗</span>
  </a>
</section>

<section class="shell overview">
  <div class="setup-heading">
    <h2>{t.choose}</h2>
    <a class="text-link" href={route(lang, 'compatibility')}>
      {t.requirements}
      <span aria-hidden="true"> ↗</span>
    </a>
  </div>
  <div class="editions">
    {[
      { name: 'No-root', access: extra.access[0], detail: t.noRoot },
      { name: 'Root', access: extra.access[1], detail: t.root }
    ].map((edition) => (
      <section>
        <h3>{edition.name}</h3>
        <p>{edition.access}</p>
        <details>
          <summary>{t.details}</summary>
          <p>{edition.detail}</p>
        </details>
      </section>
    ))}
  </div>
  <p class="setup-limits">{t.limits}</p>
  <a class="text-link" href={route(lang, 'editions')}>
    {t.nav[2]}
    <span aria-hidden="true"> ↗</span>
  </a>
</section>

<section class="shell getting-started">
  <h2>{extra.quickTitle}</h2>
  <div>
    <ol class="quick-steps">
      {extra.steps.map((step, index) => (
        <li>
          <p>{step}</p>
          <a
            class="text-link"
            href={route(lang, index === 0 ? 'editions' : 'install')}
          >
            {index === 0 ? t.nav[2] : t.details}
            <span aria-hidden="true"> ↗</span>
          </a>
        </li>
      ))}
    </ol>
    <div class="actions">
      <a class="button" href={route(lang, 'install')}>
        {t.nav[1]}
      </a>
      <a class="text-link" href={repo + '/releases/latest'}>
        {t.download}
      </a>
    </div>
  </div>
</section>

<section class="shell reading-section">
  <div class="section-heading">
    <h2>
      <a href={articleRoute(lang)}>{articleCopy[lang].title}</a>
    </h2>
    <p>{articleCopy[lang].description}</p>
  </div>
  <ul class="journal-list">
    {articles.map(({ data }) => (
      <li>
        <h3>
          <a href={articleRoute(lang, data.topic)}>
            {data.title}
            <span aria-hidden="true"> ↗</span>
          </a>
        </h3>
        <p>{data.description}</p>
      </li>
    ))}
  </ul>
</section>

<section class="shell help-section">
  <h2>{extra.helpTitle}</h2>
  <p>{extra.helpDescription}</p>
  <a class="text-link" href={route(lang, 'help')}>
    {extra.helpTitle}
    <span aria-hidden="true"> ↗</span>
  </a>
</section>

<style is:global>
  @import '../home.css';
</style>
