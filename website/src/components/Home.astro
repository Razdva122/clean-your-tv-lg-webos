---
import { support } from '../lib/support';
import { articleCopy, articleRoute, getArticles } from '../lib/articles';
import { landingCopy } from '../lib/landing';
import LauncherShowcase from './LauncherShowcase.astro';
import { copy, route, base, type Locale } from '../lib/site';
const { lang } = Astro.props as { lang: Locale };
const t = copy[lang],
  extra = support[lang],
  landing = landingCopy[lang];
const articles = (await getArticles()).filter(
  (entry) => entry.data.lang === lang
);
---

<section
  class="hero hero--centred bg-topglow"
  data-enter
  aria-labelledby="hero-title"
>
  <div class="wrap">
    <div class="hero-text">
      <h1 id="hero-title">{landing.headline}</h1>
      <p class="hero__lead">{landing.intro}</p>
      <div class="btn-row">
        <a class="btn btn--primary" href={route(lang, 'install')}>
          {landing.installLabel}
        </a>
        <a class="btn btn--secondary" href={base + 'demo/'} data-open-demo>
          {landing.tryLabel}
        </a>
      </div>
      <LauncherShowcase lang={lang} />
    </div>
  </div>
</section>
<section
  class="section feature-section"
  id="your-apps"
  data-moment={lang === 'hi' ? 'word-highlight' : 'letters-assemble'}
  data-moment-opts='{"heading":"h2","spread":0.4}'
  aria-labelledby="apps-title"
>
  <div class="wrap">
    <h2 id="apps-title">{landing.featureTitle}</h2>
    <div class="feature-layout grid">
      <div class="feature-copy">
        <ul class="feature-list">
          {landing.features.map((text) => (
            <li>{text}</li>
          ))}
        </ul>
        <p>{t.limits}</p>
        <a class="link" href={route(lang, 'themes')}>
          {t.nav[4]}{' '}
        </a>
      </div>
      <div class="feature-visual frame">
        <img
          src={base + 'assets/previews/classic-still.webp'}
          srcset={`${base}assets/previews/classic-still-small.webp 480w, ${base}assets/previews/classic-still.webp 960w`}
          sizes="(max-width: 639px) calc(100vw - 48px), (max-width: 1023px) calc(100vw - 96px), 720px"
          alt={`${t.themeImage}: Classic`}
          width="960"
          height="540"
          loading="lazy"
          decoding="async"
        />
      </div>
    </div>
  </div>
</section>
<section
  class="section edition-section"
  id="editions"
  aria-labelledby="editions-title"
>
  <div class="wrap">
    <h2 id="editions-title">{t.choose}</h2>
    <div class="edition-grid grid">
      {[
        { name: 'No-root', access: extra.access[0], detail: t.noRoot },
        { name: 'Root', access: extra.access[1], detail: t.root }
      ].map((edition) => (
        <div class="edition">
          <h3>{edition.name}</h3>
          <p class="edition-access">{edition.access}</p>
          <p>{edition.detail}</p>
        </div>
      ))}
    </div>
    <div class="edition-links">
      <a class="link" href={route(lang, 'editions')}>
        {t.nav[2]}{' '}
      </a>
      <a class="link" href={route(lang, 'compatibility')}>
        {t.requirements}{' '}
      </a>
    </div>
  </div>
</section>
<section
  class="section reading-section"
  id="guides"
  aria-labelledby="guides-title"
>
  <div class="wrap">
    <h2 id="guides-title">{articleCopy[lang].title}</h2>
    <div class="reading-layout grid">
      <div class="reading-intro">
        <p>{articleCopy[lang].description}</p>
        <a class="link" href={route(lang, 'help')}>
          {extra.helpTitle}{' '}
        </a>
      </div>
      <ul class="journal-list">
        {articles.map(({ data }) => (
          <li>
            <div>
              <h3>
                <a href={articleRoute(lang, data.topic)}>{data.title}</a>
              </h3>
              <p>{data.description}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
<style is:global>@import '../home.css';</style>
