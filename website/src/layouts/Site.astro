---
import {
  copy,
  locales,
  sections,
  route,
  base,
  origin,
  repo,
  description,
  type Locale,
  type Section,
} from "../lib/site";
import "../styles.css";
interface Props {
  lang: Locale;
  section?: Section;
  root?: boolean;
}
const { lang, section = "", root = false } = Astro.props;
const t = copy[lang],
  index = sections.indexOf(section);
const title = section
  ? `${t.nav[index]} | Clean Your TV — LG webOS`
  : `Clean Your TV — LG webOS | ${t.headline}`;
const canonical = origin + route(lang, section);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description(lang, section)} />
    <link rel="canonical" href={canonical} />
    {locales.map((code) => (
      <link
        rel="alternate"
        hreflang={code}
        href={origin + route(code, section)}
      />
    ))}
    <link
      rel="alternate"
      hreflang="x-default"
      href={origin + route("en", section)}
    />
    <link
      rel="icon"
      type="image/svg+xml"
      href={base + "assets/symbol-color.svg"}
    />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description(lang, section)} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={origin + base + "assets/classic.jpg"} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#241D19" />
  </head>
  <body>
    <a class="skip" href="#content">
      {t.skip}
    </a>
    <header class="site-header">
      <a class="brand" href={route(lang)} aria-label="Clean Your TV">
        <img
          src={base + "assets/logo-dark.svg"}
          alt="Clean Your TV — for LG webOS"
          width="250"
          height="70"
        />
      </a>
      <nav aria-label={t.readMore}>
        {sections.map((page, i) => (
          <a
            href={route(lang, page)}
            aria-current={section === page ? "page" : undefined}
          >
            {t.nav[i]}
          </a>
        ))}
      </nav>
      <details class="languages">
        <summary>
          {t.language}: <span>{t.name}</span>
        </summary>
        <nav aria-label={t.language}>
          {locales.map((code) => (
            <a
              href={route(code, section)}
              hreflang={code}
              lang={code}
              aria-current={lang === code ? "true" : undefined}
            >
              {copy[code].name}
            </a>
          ))}
        </nav>
      </details>
    </header>
    <main id="content" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer">
      <p>{t.footer}</p>
      <div>
        <a href={repo}>{t.source}</a>
        <a href={route(lang, "help")}>{t.nav[5]}</a>
        <a href={repo + "/releases/latest"}>{t.download}</a>
      </div>
    </footer>
    {root && <script is:inline>
      if (location.hash === "#root" || location.hash === "#no-root")
        location.replace("demo/" + location.hash);
    </script>}
  </body>
</html>
