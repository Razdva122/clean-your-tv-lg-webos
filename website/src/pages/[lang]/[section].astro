---
import { getEntry, render } from 'astro:content';
import Site from '../../layouts/Site.astro';
import Comparison from '../../components/Comparison.astro';
import CompatibilityReports from '../../components/CompatibilityReports.astro';
import { support, topics } from '../../lib/support';
import {
  locales,
  sections,
  copy,
  route,
  base,
  repo,
  type Locale,
  type Section
} from '../../lib/site';
export function getStaticPaths() {
  return locales.flatMap((lang) =>
    sections.filter(Boolean).map((section) => ({ params: { lang, section } }))
  );
}
const lang = Astro.params.lang as Locale,
  section = Astro.params.section as Section,
  t = copy[lang],
  extra = support[lang];
const entry =
  section === 'install' ? await getEntry('guides', lang) : undefined;
if (section === 'install' && !entry)
  throw new Error(`Missing installation translation: ${lang}`);
const rendered = entry ? await render(entry) : undefined;
const Content = rendered?.Content;
---

<Site lang={lang} section={section}>
  <div class="article-shell">
    <aside class="article-nav">
      <a href={route(lang)} class="back">
        Clean Your TV
      </a>
      <nav aria-label={t.readMore}>
        {sections.filter(Boolean).map((page) => (
          <a
            href={route(lang, page)}
            aria-current={page === section ? 'page' : undefined}
          >
            {t.nav[sections.indexOf(page)]}
          </a>
        ))}
      </nav>
      <a class="button secondary" href={base + 'demo/'}>
        {t.tryDemo}
      </a>
    </aside>
    <article class="prose">
      {section === 'install' ? (
        <>{Content && <Content />}</>
      ) : (
        <>
          <h1>{t.nav[sections.indexOf(section)]}</h1>
          {section === 'editions' && (
            <>
              <p class="lead">{t.choose}</p>
              <Comparison lang={lang} />
              <h2>No-root</h2>
              <p>{t.noRoot}</p>
              <h2>Root</h2>
              <p>{t.root}</p>
              <h2>{t.nav[3]}</h2>
              <p>{t.compatibility}</p>
              <a class="text-link" href={route(lang, 'compatibility')}>
                {t.requirements}
              </a>
            </>
          )}
          {section === 'compatibility' && (
            <>
              <p class="lead">{t.compatibility}</p>
              <Comparison lang={lang} compact />
              <CompatibilityReports lang={lang} />
              <h2>{extra.checksTitle}</h2>
              <ul>
                {extra.checks.map((check) => (
                  <li>{check}</li>
                ))}
              </ul>
              <p>
                <a
                  class="text-link"
                  href={repo + '/blob/main/docs/COMPATIBILITY.md'}
                >
                  {t.evidence}
                </a>
              </p>
              <p>
                <a class="text-link" href={route(lang, 'help')}>
                  {extra.helpTitle}
                </a>
              </p>
            </>
          )}
          {section === 'help' && (
            <>
              <p class="lead">{extra.helpDescription}</p>
              <ul class="topic-links" aria-label={extra.helpTitle}>
                {topics.map((topic, index) => (
                  <li>
                    <a href={'#' + topic.id}>{extra.help[index][0]}</a>
                  </li>
                ))}
              </ul>
              {topics.map((topic, index) => (
                <section id={topic.id}>
                  <h2>{extra.help[index][0]}</h2>
                  <p>{extra.help[index][1]}</p>
                  <a href={repo + '/blob/main/' + topic.reference}>
                    {extra.referenceLabel}
                  </a>
                </section>
              ))}
            </>
          )}
          {section === 'themes' && (
            <>
              <p class="lead">{t.themes}</p>
              {['Classic', 'Liquid Glass', 'Ribbon'].map((theme) => (
                <figure>
                  <img
                    src={
                      base +
                      'assets/' +
                      theme.toLowerCase().replace(/ /g, '-') +
                      '.jpg'
                    }
                    alt={`${t.themeImage}: ${theme}`}
                    width="1920"
                    height="1080"
                    loading="lazy"
                  />
                  <figcaption>{theme}</figcaption>
                </figure>
              ))}
              <a class="button secondary" href={base + 'demo/'}>
                {t.tryDemo}
              </a>
            </>
          )}
          <hr />
          <p>{t.limits}</p>
          <div class="actions">
            <a class="button" href={route(lang, 'install')}>
              {t.nav[1]}
            </a>
            <a href={repo + '/releases/latest'}>{t.download}</a>
          </div>
        </>
      )}
    </article>
  </div>
</Site>

<style is:global>
  @import "../../article.css";
</style>
