---
import { render } from 'astro:content';
import Site from '../../../layouts/Site.astro';
import ArticleBreadcrumbs from '../../../components/ArticleBreadcrumbs.astro';
import { articleCopy, articleRoute, getArticles } from '../../../lib/articles';
import { repo } from '../../../lib/site';
export async function getStaticPaths() {
  return (await getArticles()).map((entry) => ({
    params: { lang: entry.data.lang, topic: entry.data.topic },
    props: { entry }
  }));
}
const { entry } = Astro.props;
const { data } = entry;
const lang = data.lang;
const labels = articleCopy[lang];
const { Content, headings } = await render(entry);
const related = (await getArticles()).filter(
  (other) => other.data.lang === lang && other.data.topic !== data.topic
);
---

<Site lang={lang} article={data}>
  <div class="article-shell">
    <aside class="article-nav">
      <a class="back" href={articleRoute(lang)}>
        {labels.title}
      </a>
      <nav aria-label={labels.contentsLabel}>
        {headings
          .filter((heading) => heading.depth === 2)
          .map((heading) => (
            <a href={'#' + heading.slug}>{heading.text}</a>
          ))}
      </nav>
    </aside>
    <article class="prose">
      <ArticleBreadcrumbs lang={lang} title={data.title} />
      <h1>{data.title}</h1>
      <p class="article-meta">
        <a href={repo}>Clean Your TV</a> · {labels.updatedLabel}{' '}
        <time datetime={data.updated}>
          {new Intl.DateTimeFormat(lang, {
            dateStyle: 'long',
            timeZone: 'UTC'
          }).format(new Date(data.updated))}
        </time>
      </p>
      <Content />
      <hr />
      <nav aria-label={labels.relatedLabel}>
        <h2>{labels.relatedLabel}</h2>
        <ul>
          {related.map(({ data }) => (
            <li>
              <a href={articleRoute(lang, data.topic)}>{data.title}</a>
            </li>
          ))}
        </ul>
      </nav>
    </article>
  </div>
</Site>

<style is:global>
  @import '../../../article.css';
</style>
